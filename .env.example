# ==============================================================================
# Flower Market Platform - Environment Variables Template
# Copy this file to .env or .env.local and populate with your real values.
# NEVER commit .env or files with real secrets to version control!
# ==============================================================================

# --- Backend Configuration ---
PORT=5000
NODE_ENV=development
API_PREFIX=/api

# Database Connection (PostgreSQL via Supabase / Render / Neon / Local)
DATABASE_URL="postgresql://user:password@localhost:5432/dbname"

# JWT Authentication Secrets (Use strong random strings in production)
JWT_SECRET="your_jwt_access_secret_key_here"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="your_jwt_refresh_secret_key_here"
JWT_REFRESH_EXPIRES_IN="30d"

# CORS Frontend URL
FRONTEND_URL="http://localhost:5173"

# Stripe Payment Gateway
STRIPE_SECRET_KEY="your_stripe_secret_key_here"
STRIPE_WEBHOOK_SECRET="your_stripe_webhook_secret_here"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Seed Account Passwords (Optional override during development database seeding)
SEED_USER_PASSWORD="your_development_user_password"
SEED_ADMIN_PASSWORD="your_development_admin_password"
SEED_MANAGER_PASSWORD="your_development_manager_password"

# --- Frontend Configuration (Vite) ---
VITE_API_URL=http://localhost:5000/api
VITE_APP_NAME="Flower Market & Botanical Services"
VITE_ENABLE_AI_CHAT=true
