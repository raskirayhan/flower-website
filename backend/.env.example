# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api

# Database Connection (PostgreSQL via Supabase / Render / Local)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fixitnow_db?schema=public"

# JSON Web Token Secrets
JWT_SECRET="fixitnow_super_secret_jwt_access_token_key_2026"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="fixitnow_super_secret_jwt_refresh_token_key_2026"
JWT_REFRESH_EXPIRES_IN="30d"

# CORS Allowed Origin
FRONTEND_URL="http://localhost:5173"

# Stripe Payment Gateway
STRIPE_SECRET_KEY="sk_test_demo_fixitnow_botanical_stripe_key"
STRIPE_WEBHOOK_SECRET="whsec_demo_webhook_secret_key"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
