# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api

# Database Connection (PostgreSQL via Supabase / Render / Local)
DATABASE_URL="postgresql://user:password@localhost:5432/dbname"

# JSON Web Token Secrets
JWT_SECRET="fixitnow_super_secret_jwt_access_token_key_2026"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="fixitnow_super_secret_jwt_refresh_token_key_2026"
JWT_REFRESH_EXPIRES_IN="30d"

# CORS Allowed Origin
FRONTEND_URL="http://localhost:5173"

# Stripe Payment Gateway
STRIPE_SECRET_KEY="your_stripe_secret_key_here"
STRIPE_WEBHOOK_SECRET="your_stripe_webhook_secret_here"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
