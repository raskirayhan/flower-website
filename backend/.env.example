# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api

# Database Connection (PostgreSQL via Supabase / Neon / Render / Local)
# Replace with your actual credentials: postgresql://<user>:<password>@<host>:<port>/<dbname>?schema=public
DATABASE_URL="postgresql://user:password@localhost:5432/dbname"

# JSON Web Token Secrets (Generate secure random 32+ byte strings in production)
JWT_SECRET="your_jwt_access_secret_key_here"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="your_jwt_refresh_secret_key_here"
JWT_REFRESH_EXPIRES_IN="30d"

# CORS Allowed Origin
FRONTEND_URL="http://localhost:5173"

# Stripe Payment Gateway (Obtain keys from your Stripe Dashboard: https://dashboard.stripe.com)
STRIPE_SECRET_KEY="your_stripe_secret_key_here"
STRIPE_WEBHOOK_SECRET="your_stripe_webhook_secret_here"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
